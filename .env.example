# Copy this file to ".env" and adjust the values for your machine.
# Everything is optional - the defaults work out of the box for development.

# development | production
SGP_ENV=development

# Change this to a long random string, especially in production.
SGP_SECRET_KEY=dev-secret-change-me

# 1 = show debug pages, 0 = off (forced off in production)
SGP_DEBUG=1

# Where the SQLite database and generated files live.
# SGP_DB_NAME=students.db
# SGP_CSV_FILE=student_records.csv
# SGP_LOG_FILE=app.log
# SGP_LOG_LEVEL=INFO

# Sessions
SGP_SESSION_MINUTES=60
# Force cookies over HTTPS only. Leave 0 for local http development.
SGP_COOKIE_SECURE=0

# Login lockout
SGP_LOGIN_MAX_ATTEMPTS=5
SGP_LOGIN_LOCKOUT_SECONDS=300

# Rows per page in the student list
SGP_PAGE_SIZE=10

# Optional: email report cards (leave disabled unless you have SMTP details)
SGP_MAIL_ENABLED=0
SGP_MAIL_SERVER=
SGP_MAIL_PORT=587
SGP_MAIL_USERNAME=
SGP_MAIL_PASSWORD=
SGP_MAIL_SENDER=no-reply@student-grade-portal

# Token required by the JSON API in the X-API-Token header. Change it in production.
SGP_API_TOKEN=dev-api-token
